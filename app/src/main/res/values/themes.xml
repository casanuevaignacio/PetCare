<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Senior Vanguard Pastel PetCare Theme -->
    <style name="Theme.PetCare" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/sage_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/sage_light</item>
        <item name="colorOnPrimaryContainer">@color/sage_dark</item>
        
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/peach_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/warm_yellow</item>

        <!-- Tertiary brand color. -->
        <item name="colorTertiary">@color/lavender_accent</item>
        
        <!-- Status bar and navigation bar. -->
        <item name="android:statusBarColor">@color/sage_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/background_light</item>

        <!-- Background and surface. -->
        <item name="android:windowBackground">@color/background_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/text_dark</item>
    </style>
</resources>
